  - speaker: 
    text: "\uC0B4\uC544\uB0A8\uC740 \uC0AC\uB78C\uB4E4\uC740 \uB3C4\uC2DC \uACF3\uACF3\uC5D0
      \uC228\uC5B4 \uD558\uB8E8\uD558\uB8E8\uB97C \uBC84\uD168 \uB098\uAC14\uB2E4."
    portrait: {fileID: 0}
  - speaker: 
    text: "\uADF8\uB9AC\uACE0 \uC5B4\uB290 \uB0A0, \uCE74\uC774\uC5D0\uAC8C \uB9C8\uC9C0\uB9C9
