--- !u!114 &1371899185
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1371899184}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5568a434771bdf24b91141b51a562ec8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Talk
  lines:
  - speaker: "\uB85C\uC6EC"
    text: "\uC654\uAD6C\uB098, \uCE74\uC774. \uC624\uB298\uB3C4 \uB2A6\uC5C8\uAD70."
  - speaker: "\uCE74\uC774"
    text: "\uBC16\uC774 \uB09C\uB9AC\uC608\uC694. \uAE38\uB9C8\uB2E4 \uC774\uC0C1\uD55C
      \uB188\uB4E4\uC774 \uB3CC\uC544\uB2E4\uB140\uC694."
  - speaker: "\uB85C\uC6EC"
    text: "\uC54C\uACE0 \uC788\uB2E4. \uADF8\uB798\uC11C \uB124\uAC8C \uBD80\uD0C1\uD560
      \uC77C\uC774 \uC788\uC5B4."
  - speaker: "\uCE74\uC774"
    text: "\uC124\uB9C8 \uB610 \uBC30\uB2EC\uC778\uAC00\uC694?"
  - speaker: "\uB85C\uC6EC"
    text: "\uADF8\uB798. \uD558\uC9C0\uB9CC \uC774\uBC88\uC774 \uB9C8\uC9C0\uB9C9\uC774
      \uB420 \uAC70\uB2E4."
  - speaker: "\uCE74\uC774"
    text: "\uB9C8\uC9C0\uB9C9\uC774\uB77C\uB2C8\uC694? \uBB34\uC2A8 \uB73B\uC774\uC5D0\uC694?"
  - speaker: "\uB85C\uC6EC"
    text: "\uB3C4\uC2DC \uBD81\uCABD\uC758 \uD3D0\uC1C4\uB41C \uD1B5\uC2E0\uD0D1.
      \uADF8\uACF3\uC5D0 \uC774 \uC0C1\uC790\uB97C \uC804\uB2EC\uD574\uB77C."
  - speaker: "\uCE74\uC774"
    text: "\uD1B5\uC2E0\uD0D1\uC740 \uBA87 \uB144 \uC804\uC5D0 \uD3D0\uC1C4\uB410\uC796\uC544\uC694."
  - speaker: "\uB85C\uC6EC"
    text: "\uADF8\uACF3\uC5D0\uC11C \uC544\uC9C1 \uB204\uAD70\uAC00 \uAE30\uB2E4\uB9AC\uACE0
      \uC788\uC5B4."
  - speaker: "\uCE74\uC774"
    text: "\uB204\uAC00 \uAE30\uB2E4\uB9AC\uACE0 \uC788\uB294\uB370\uC694?"
  - speaker: "\uB85C\uC6EC"
    text: "...\uADF8\uAC74 \uB3C4\uCC29\uD558\uBA74 \uC54C\uAC8C \uB420 \uAC70\uB2E4."
  choice1: "\uC54C\uACA0\uC5B4\uC694. \uC81C\uAC00 \uAC00\uACA0\uC2B5\uB2C8\uB2E4."
  choice2: "\uBCF4\uC218\uB294 \uC81C\uB300\uB85C \uC8FC\uC2E4 \uAC70\uC8E0?"
  onChoice1:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 975269443}
        m_TargetAssemblyTypeName: Talk, Assembly-CSharp
        m_MethodName: Say
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
