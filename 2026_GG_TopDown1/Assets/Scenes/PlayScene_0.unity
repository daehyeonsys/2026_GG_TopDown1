MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 975269442}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5568a434771bdf24b91141b51a562ec8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Talk
  lines:
  - speaker: "\uB85C\uC6EC"
    text: "\uC7A0\uAE50. \uB9E8\uC190\uC73C\uB85C \uB098\uAC08 \uC0DD\uAC01\uC740
      \uC544\uB2C8\uACA0\uC9C0?"
  - speaker: "\uCE74\uC774"
    text: "\uC2F8\uC6B0\uB7EC \uAC00\uB294 \uAC74 \uC544\uB2C8\uC796\uC544\uC694."
  - speaker: "\uB85C\uC6EC"
    text: "\uBC16\uC5D0 \uC788\uB294 \uAC83\uB4E4\uC740 \uADF8\uB7F0 \uC0AC\uC815
      \uBD10\uC8FC\uC9C0 \uC54A\uC544. \uC791\uC5C5\uB300\uC5D0 \uBB34\uAE30\uB97C
      \uC900\uBE44\uD574 \uB480\uB2E4."
  - speaker: "\uCE74\uC774"
    text: "\uC1E0\uD30C\uC774\uD504\uC5D0... \uAD8C\uCD1D\uAE4C\uC9C0\uC694?"
  - speaker: "\uB85C\uC6EC"
    text: "\uD30C\uC774\uD504\uB294 \uAC00\uAE4C\uC774 \uBD99\uC5C8\uC744 \uB54C
      \uC4F0\uACE0, \uAD8C\uCD1D\uC740 \uC815\uB9D0 \uC704\uD5D8\uD560 \uB54C\uB9CC
      \uC368\uB77C. \uD0C4\uC57D\uC740 \uB109\uB109\uD558\uC9C0 \uC54A\uC73C\uB2C8\uAE4C."
  - speaker: "\uCE74\uC774"
    text: "\uC54C\uACA0\uC5B4\uC694. \uC870\uC2EC\uD560\uAC8C\uC694."
  - speaker: "\uB85C\uC6EC"
    text: "\uADF8\uB9AC\uACE0 \uCE74\uC774... \uC0C1\uC790\uB294 \uC808\uB300 \uC5F4\uC5B4\uBCF4\uC9C0
      \uB9C8\uB77C."
  choice1: 
  choice2: 
  onChoice1:
    m_PersistentCalls:
      m_Calls: []
  onChoice2:
    m_PersistentCalls:
      m_Calls: []
  prompt: {fileID: 0}
  dialogueBox: {fileID: 1409942110}
